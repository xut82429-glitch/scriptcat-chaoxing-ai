{
  "manifest_version": 3,
  "name": "ChaoXing Phantom Agent v4.0",
  "version": "4.0.0",
  "description": "超星学习通智能答题助手 - 支持 Agnes.ai 3.0 Flash 及自定义 LLM",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.mooc1.chaoxing.com/*",
    "*://*.mooc2.chaoxing.com/*",
    "*://*.xueyinonline.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.mooc1.chaoxing.com/*",
        "*://*.mooc2.chaoxing.com/*",
        "*://*.xueyinonline.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Phantom Agent 设置"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["libs/*"],
      "matches": ["*://*.chaoxing.com/*"]
    }
  ]
}
