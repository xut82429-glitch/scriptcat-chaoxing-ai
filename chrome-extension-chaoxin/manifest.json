{
  "manifest_version": 3,
  "name": "ChaoXing Agent - AI Autonomous Learner",
  "version": "2.0-agent",
  "description": "基于LLM Agent的超星学习通自主刷题助手，具备动态拟人行为、三层字体防御和环境自适应能力",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.edu.cn/*",
    "*://*.nbdlib.cn/*",
    "*://*.hnsyu.net/*",
    "*://*.gdhkmooc.com/*",
    "*://*.mooc1.chaoxing.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api.anthropic.com/*",
    "https://open.bigmodel.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.xiaomimimo.com/*",
    "https://token-plan-cn.xiaomimimo.com/*",
    "https://www.baidu.com/*",
    "https://www.bing.com/*",
    "https://cn.bing.com/*",
    "https://duckduckgo.com/*",
    "https://api.agnes.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.edu.cn/*",
        "*://*.nbdlib.cn/*",
        "*://*.hnsyu.net/*",
        "*://*.gdhkmooc.com/*",
        "*://*.mooc1.chaoxing.com/*"
      ],
      "js": ["agent-core.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChaoXing Agent",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["*.css", "*.ttf", "*.woff", "*.json", "libs/*.js"],
      "matches": ["*://*.chaoxing.com/*", "*://*.edu.cn/*"]
    }
  ]
}
