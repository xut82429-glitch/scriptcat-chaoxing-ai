{
  "manifest_version": 3,
  "name": "ChaoXing Agent v3.0 - Phantom",
  "version": "3.0.0",
  "description": "企业级超星学习通智能辅助系统 | 多智能体编排 | 军用级反检测 | Agnes.ai 深度集成",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.mooc1.chaoxing.com/*",
    "*://*.mooc2.chaoxing.com/*",
    "*://api.agnes.ai/*",
    "*://*.openai.com/*",
    "*://*.deepseek.com/*",
    "*://*.aliyuncs.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.chaoxing.com/*", "*://*.mooc1.chaoxing.com/*", "*://*.mooc2.chaoxing.com/*"],
      "js": ["libs/font-decoder.js", "libs/human-behavior.js", "libs/anti-detect.js", "libs/agent-core.js", "content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ChaoXing Agent v3.0"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["libs/*.js", "strategies/*.js"],
      "matches": ["*://*.chaoxing.com/*"]
    }
  ]
}
